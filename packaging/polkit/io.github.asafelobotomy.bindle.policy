<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Installed by `bindle first-login install`. Gives the desktop window's
     password dialog (pkexec /usr/local/bin/bindle helper) a clear message. -->
<policyconfig>
  <vendor>Bindle</vendor>
  <vendor_url>https://github.com/asafelobotomy/bindle</vendor_url>
  <action id="io.github.asafelobotomy.bindle.apply">
    <description>Apply Bindle's setup</description>
    <message>Bindle needs administrator rights to install packages and change system settings.</message>
    <icon_name>bindle</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/bindle</annotate>
  </action>
</policyconfig>
